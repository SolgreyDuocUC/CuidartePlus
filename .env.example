# Copia este archivo a .env y completa los valores: cp .env.example .env
COMPOSE_PROJECT_NAME=cuidarteplus-ev
NODE_ENV=production

# Base de datos (solo accesible en la red interna de Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=          # obligatorio — genera uno con: openssl rand -hex 24
POSTGRES_DB=cuidarteplus

# Llave para firmar los JWT
JWT_SECRET=                 # obligatorio — genera uno con: openssl rand -hex 32

# Puerto público del frontend (nginx). En EC2 usar 80.
PORT_FRONTEND=3333
FRONTEND_URL=http://localhost:3333

# Solo usados con docker-compose.dev.yml (publicados en 127.0.0.1)
PORT_POSTGRES=15442
PORT_BACKEND=4444
